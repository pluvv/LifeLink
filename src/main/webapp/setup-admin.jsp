<%@ page contentType="text/html;charset=UTF-8" language="java" %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Initial administrator setup · LifeLink</title><link rel="stylesheet" href="assets/css/style.css"></head><body><nav class="nav"><a class="brand" href="index.jsp">Life<span>Link</span></a></nav><main class="auth"><section class="auth-card"><p class="eyebrow">FIRST-TIME SETUP</p><h1>Create admin account</h1><p class="muted">This one-time setup is available only while the database has no administrator account. Use a unique password with at least 10 characters.</p><%if("invalid".equals(request.getParameter("error"))){%><div class="notice">Please fill all fields and use a valid email and password (10+ characters).</div><%}else if("failed".equals(request.getParameter("error"))){%><div class="notice">Setup failed. Check the database connection, then retry.</div><%}%><form method="post" action="setup-admin"><input type="hidden" name="csrfToken" value="<%=session.getAttribute("csrfToken")%>"/><label>Full name</label><input name="fullName" required maxlength="120"><label>Email</label><input type="email" name="email" required maxlength="190"><label>Password (10+ characters)</label><input type="password" name="password" required minlength="10"><button class="primary full" type="submit">Create administrator</button></form><p class="muted center">This page closes automatically after an admin is created.</p></section></main></body></html>