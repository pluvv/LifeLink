<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Login · LifeLink</title><link rel="stylesheet" href="assets/css/style.css"></head><body>
<nav class="nav"><a class="brand" href="index.jsp">Life<span>Link</span></a><a href="register.jsp">Create account</a></nav>
<main class="auth"><div class="auth-card"><p class="eyebrow">WELCOME BACK</p><h1>Sign in to LifeLink</h1><p class="muted">Access your blood donation and inventory workspace.</p>
<% String err=request.getParameter("error"); if(err!=null){String msg="Please check your credentials."; if("pending".equals(err))msg="Your account is awaiting admin approval.";else if("rejected".equals(err))msg="Your registration was rejected. Contact an administrator.";else if("database".equals(err))msg="Database unavailable. Please try again shortly.";else if("missing".equals(err))msg="Enter both email and password."; %><div class="notice"><%=msg%></div><% } %>
<form method="post" action="login"><label>Email address</label><input type="email" name="email" required autocomplete="email"><label>Password</label><input type="password" name="password" required autocomplete="current-password"><button class="primary full" type="submit">Sign in</button></form><p class="muted center">New to LifeLink? <a href="register.jsp">Create an account</a></p></div></main></body></html>
