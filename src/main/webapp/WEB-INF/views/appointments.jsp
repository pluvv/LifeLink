<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.*" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><% List<Map<String,Object>> banks=(List<Map<String,Object>>)request.getAttribute("banks");List<Map<String,Object>> appointments=(List<Map<String,Object>>)request.getAttribute("appointments"); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Donation appointments · LifeLink</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><nav class="nav"><a class="brand" href="<%=request.getContextPath()%>/index.jsp">Life<span>Link</span></a><a class="secondary small" href="<%=request.getContextPath()%>/dashboard">Dashboard</a></nav><main class="auth"><section class="auth-card" style="width:min(100%,680px)"><p class="eyebrow">DONOR WORKSPACE</p><h1>Donation appointments</h1><p class="muted">Choose an approved blood bank and request an appointment. The bank will review your request.</p><c:if test="${param.booked eq '1'}"><div class="notice">Appointment request submitted. It is pending bank approval.</div></c:if><c:if test="${not empty param.error}"><div class="notice">We couldn't submit the appointment. Check the details and try again.</div></c:if><form method="post" action="<%=request.getContextPath()%>/appointments"><input type="hidden" name="csrfToken" value="<%=session.getAttribute("csrfToken")%>"/><label for="bankId">Approved blood bank</label><select id="bankId" name="bankId" required><option value="">Choose a blood bank</option><c:forEach items="${banks}" var="b"><option value="<c:out value='${b.id}'/>"><c:out value="${b.name}"/> — <c:out value="${b.city}"/></option></c:forEach></select><label for="scheduledAt">Preferred date and time</label><input id="scheduledAt" name="scheduledAt" type="datetime-local" required><label for="notes">Notes (optional)</label><input id="notes" name="notes" maxlength="500" placeholder="Anything the blood bank should know"><button class="primary full" type="submit">Request appointment</button></form><h2 style="font:700 20px Manrope,sans-serif;margin-top:30px">Your appointment history</h2><c:choose><c:when test="${empty appointments}"><p class="muted">You haven't requested an appointment yet.</p></c:when><c:otherwise><div style="display:grid;gap:12px"><c:forEach items="${appointments}" var="a"><article style="border:1px solid var(--line);border-radius:12px;padding:14px"><strong><c:out value="${a.bank}"/></strong><p class="muted"><c:out value="${a.city}"/> · <c:out value="${a.when}"/></p><p>Status: <strong><c:out value="${a.status}"/></strong></p><c:if test="${not empty a.notes}"><p class="muted"><c:out value="${a.notes}"/></p></c:if></article></c:forEach></div></c:otherwise></c:choose></section></main></body></html>