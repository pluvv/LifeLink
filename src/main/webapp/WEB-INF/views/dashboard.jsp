<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="com.lifelink.model.User" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><% User u=(User)request.getAttribute("currentUser");if(u==null){response.sendRedirect(request.getContextPath()+"/login.jsp");return;} %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard · LifeLink</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><nav class="nav"><a class="brand" href="<%=request.getContextPath()%>/index.jsp">Life<span>Link</span></a><form method="post" action="<%=request.getContextPath()%>/logout" style="margin:0"><input type="hidden" name="csrfToken" value="<%=session.getAttribute("csrfToken")%>"/><button class="primary small" type="submit">Sign out</button></form></nav><main class="auth"><section class="auth-card"><p class="eyebrow">ACCOUNT WORKSPACE</p><h1>Welcome, <c:out value="${currentUser.fullName}"/></h1><p class="muted">Your account is signed in. Role: <strong><c:out value="${currentUser.role}"/></strong></p><div class="notice">Your account status is <strong><c:out value="${currentUser.status}"/></strong>.</div>
<%if("ADMIN".equals(u.getRole())){%><a class="primary full" href="<%=request.getContextPath()%>/admin">Open admin approvals</a><%}%>
<%if("BLOOD_BANK".equals(u.getRole())){%><a class="primary full" href="<%=request.getContextPath()%>/inventory">Manage blood inventory</a><a class="secondary full" href="<%=request.getContextPath()%>/bank/appointments">Review donation requests</a><a class="secondary full" href="<%=request.getContextPath()%>/bank/requests">Manage recipient requests</a><a class="secondary full" href="<%=request.getContextPath()%>/bank/transfers">Bank-to-bank transfers</a><%}%>
<%if("DONOR".equals(u.getRole())){%><a class="primary full" href="<%=request.getContextPath()%>/appointments">Book a donation appointment</a><%}%>
<%if("RECIPIENT".equals(u.getRole())){%><a class="primary full" href="<%=request.getContextPath()%>/recipient/banks">Find blood banks and request blood</a><%}%>
</section></main></body></html>