 <%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="com.lifelink.model.User" %>
<% User u=(User)request.getAttribute("currentUser"); if(u==null){response.sendRedirect("../../login.jsp");return;} %>
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard · LifeLink</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><nav class="nav"><a class="brand" href="../../index.jsp">Life<span>Link</span></a><a class="primary small" href="<%=request.getContextPath()%>/logout">Sign out</a></nav><main class="auth"><section class="auth-card"><p class="eyebrow">ACCOUNT WORKSPACE</p><h1>Welcome, <%=u.getFullName()%></h1><p class="muted">Your account is signed in. Role: <strong><%=u.getRole()%></strong></p><div class="notice">Your account status is <strong><%=u.getStatus()%></strong>.</div>
<%if("ADMIN".equals(u.getRole())){%><a class="primary full" href="<%=request.getContextPath()%>/admin">Open admin approvals</a><%}%>
<%if("BLOOD_BANK".equals(u.getRole())){%><a class="primary full" href="<%=request.getContextPath()%>/inventory">Manage blood inventory</a><a class="secondary full" href="<%=request.getContextPath()%>/bank/appointments">Review donation requests</a><a class="secondary full" href="<%=request.getContextPath()%>/bank/requests">Manage recipient requests</a><a class="secondary full" href="<%=request.getContextPath()%>/bank/transfers">Bank-to-bank transfers</a><%}%>
<%if("DONOR".equals(u.getRole())){%><a class="primary full" href="<%=request.getContextPath()%>/appointments">Book a donation appointment</a><%}%>
<%if("RECIPIENT".equals(u.getRole())){%><a class="primary full" href="<%=request.getContextPath()%>/recipient/banks">Find blood banks and request blood</a><%}%>
</section></main></body></html>