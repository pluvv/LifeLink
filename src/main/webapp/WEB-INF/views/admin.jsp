<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.List,com.lifelink.model.User" %><%List<User> pending=(List<User>)request.getAttribute("pending");%>
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin · LifeLink</title><link rel="stylesheet" href="../assets/css/style.css"></head><body><nav class="nav"><a class="brand" href="../../index.jsp">Life<span>Link</span></a><a class="primary small" href="../../logout">Sign out</a></nav><main class="auth" style="align-items:start"><section class="auth-card" style="width:min(100%,900px)"><p class="eyebrow">ADMINISTRATION</p><h1>Pending registrations</h1><p class="muted">Review account requests and approve or reject each application.</p><%if(request.getAttribute("error")!=null){%><div class="notice"><%=request.getAttribute("error")%></div><%}%><%if(pending==null||pending.isEmpty()){%><div class="notice">No pending registrations. You're all caught up.</div><%}else{for(User item:pending){%><article style="border:1px solid var(--line);padding:18px;border-radius:12px;margin:12px 0"><h3 style="margin:0 0 6px"><%=item.getFullName()%></h3><p class="muted"><%=item.getEmail()%> · <%=item.getRole()%></p><form method="post" action="../../admin" style="display:flex;gap:10px"><input type="hidden" name="csrfToken" value="<%=session.getAttribute("csrfToken")%>"/><input type="hidden" name="id" value="<%=item.getId()%>"><button class="primary" name="action" value="approve">Approve</button><button class="secondary" name="action" value="reject">Reject</button></form></article><%}}%></section></main></body></html>