<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.List,com.lifelink.model.User" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%List<User> pending=(List<User>)request.getAttribute("pending");%>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin · LifeLink</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><nav class="nav"><a class="brand" href="<%=request.getContextPath()%>/index.jsp">Life<span>Link</span></a><form method="post" action="<%=request.getContextPath()%>/logout" style="margin:0"><input type="hidden" name="csrfToken" value="<%=session.getAttribute("csrfToken")%>"/><button class="primary small" type="submit">Sign out</button></form></nav><main class="auth" style="align-items:start"><section class="auth-card" style="width:min(100%,900px)"><p class="eyebrow">ADMINISTRATION</p><h1>Pending registrations</h1><p class="muted">Review account requests and approve or reject each application.</p><c:if test="${not empty error}"><div class="notice"><c:out value="${error}"/></div></c:if><c:choose><c:when test="${empty pending}"><div class="notice">No pending registrations. You're all caught up.</div></c:when><c:otherwise><c:forEach items="${pending}" var="item"><article style="border:1px solid var(--line);padding:18px;border-radius:12px;margin:12px 0"><h3 style="margin:0 0 6px"><c:out value="${item.fullName}"/></h3><p class="muted"><c:out value="${item.email}"/> · <c:out value="${item.role}"/></p><form method="post" action="<%=request.getContextPath()%>/admin" style="display:flex;gap:10px"><input type="hidden" name="csrfToken" value="<%=session.getAttribute("csrfToken")%>"/><input type="hidden" name="id" value="<c:out value='${item.id}'/>"><button class="primary" name="action" value="approve">Approve</button><button class="secondary" name="action" value="reject">Reject</button></form></article></c:forEach></c:otherwise></c:choose></section></main></body></html>