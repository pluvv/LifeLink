<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.*" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><% List<Map<String,Object>> banks=(List<Map<String,Object>>)request.getAttribute("banks");List<Map<String,Object>> transfers=(List<Map<String,Object>>)request.getAttribute("transfers"); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Blood transfers · LifeLink</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><nav class="nav"><a class="brand" href="<%=request.getContextPath()%>/index.jsp">Life<span>Link</span></a><a class="secondary small" href="<%=request.getContextPath()%>/dashboard">Dashboard</a></nav><main class="auth"><section class="auth-card" style="width:min(100%,850px)"><p class="eyebrow">BLOOD BANK WORKSPACE</p><h1>Bank-to-bank transfers</h1><p class="muted">Request stock from another approved bank. The receiving bank can accept or reject; acceptance moves stock atomically from the sender to the receiver.</p><c:if test="${param.created eq '1' or param.updated eq '1'}"><div class="notice">Transfer updated successfully.</div></c:if><c:if test="${not empty param.error}"><div class="notice"><c:choose><c:when test="${param.error eq 'stock'}">The sending bank does not have enough recorded stock.</c:when><c:otherwise>The transfer could not be processed. Check its status and details.</c:otherwise></c:choose></div></c:if><h2>Request a transfer</h2><form method="post" action="<%=request.getContextPath()%>/bank/transfers"><input type="hidden" name="action" value="create"/><label>Receiving blood bank</label><select name="destinationId" required><option value="">Choose a bank</option><c:forEach items="${banks}" var="b"><option value="<c:out value='${b.id}'/>"><c:out value="${b.name}"/> — <c:out value="${b.city}"/></option></c:forEach></select><label>Blood group</label><select name="bloodGroup" required><option value="">Choose group</option><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select><label>Units</label><input type="number" name="units" min="1" max="100" value="1" required/><button class="primary full" type="submit">Send transfer request</button></form><h2 style="margin-top:30px">Transfer activity</h2><c:choose><c:when test="${empty transfers}"><p class="muted">No transfer activity yet.</p></c:when><c:otherwise><div style="display:grid;gap:12px"><c:forEach items="${transfers}" var="t"><article style="border:1px solid var(--line);border-radius:12px;padding:15px"><strong><c:out value="${t.from}"/> → <c:out value="${t.to}"/></strong><p><c:out value="${t.group}"/> · <c:out value="${t.units}"/> units · <strong><c:out value="${t.status}"/></strong></p><p class="muted"><c:out value="${t.created}"/></p><c:if test="${t.toId eq sessionScope.user.id and t.status eq 'PENDING'}"><form method="post" action="<%=request.getContextPath()%>/bank/transfers" style="display:flex;gap:8px"><input type="hidden" name="transferId" value="<c:out value='${t.id}'/>"/><button class="primary" name="action" value="approve">Accept and receive</button><button class="secondary" name="action" value="reject">Reject</button></form></c:if></article></c:forEach></div></c:otherwise></c:choose></section></main></body></html>