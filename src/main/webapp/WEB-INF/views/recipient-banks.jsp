<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.*" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><% List<Map<String,Object>> banks=(List<Map<String,Object>>)request.getAttribute("banks"); List<Map<String,Object>> requests=(List<Map<String,Object>>)request.getAttribute("requests"); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Find blood banks · LifeLink</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><nav class="nav"><a class="brand" href="<%=request.getContextPath()%>/index.jsp">Life<span>Link</span></a><a class="secondary small" href="<%=request.getContextPath()%>/dashboard">Dashboard</a></nav><main class="auth"><section class="auth-card" style="width:min(100%,900px)"><p class="eyebrow">RECIPIENT WORKSPACE</p><h1>Find blood banks</h1><p class="muted">View recorded stock at approved blood banks and send a request. Availability is subject to confirmation.</p><c:if test="${param.requested eq '1'}"><div class="notice">Your request was submitted and is pending bank review.</div></c:if><c:if test="${not empty param.error}"><div class="notice">We couldn't submit that request. Check the details and try again.</div></c:if><h2>Approved blood banks and recorded stock</h2><c:choose><c:when test="${empty banks}"><p class="muted">No approved blood banks are listed yet.</p></c:when><c:otherwise><div style="display:grid;gap:12px"><c:forEach items="${banks}" var="b"><article style="border:1px solid var(--line);border-radius:12px;padding:15px"><strong><c:out value="${b.name}"/></strong><p class="muted"><c:out value="${b.address}"/>, <c:out value="${b.city}"/></p><p><strong>Recorded stock:</strong> <c:out value="${empty b.stockSummary ? 'No stock recorded' : b.stockSummary}"/></p><form method="post" action="<%=request.getContextPath()%>/recipient/banks" style="display:flex;gap:8px;align-items:end;flex-wrap:wrap"><input type="hidden" name="bankId" value="<c:out value='${b.id}'/>"/><div style="min-width:130px;flex:1"><label>Blood group</label><select name="bloodGroup" required><option value="">Choose</option><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select></div><div style="width:100px"><label>Units</label><input name="units" type="number" min="1" max="100" value="1" required></div><button class="primary" type="submit">Request blood</button></form></article></c:forEach></div></c:otherwise></c:choose><h2 style="margin-top:30px">Your requests</h2><c:choose><c:when test="${empty requests}"><p class="muted">You haven't made a request yet.</p></c:when><c:otherwise><div style="display:grid;gap:10px"><c:forEach items="${requests}" var="r"><article style="border:1px solid var(--line);border-radius:12px;padding:14px"><strong><c:out value="${r.bank}"/></strong> · <c:out value="${r.city}"/><p><c:out value="${r.group}"/> · <c:out value="${r.units}"/> units · <strong><c:out value="${r.status}"/></strong></p><p class="muted"><c:out value="${r.created}"/></p></article></c:forEach></div></c:otherwise></c:choose></section></main></body></html>