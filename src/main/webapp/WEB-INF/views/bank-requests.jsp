<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.*" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><% List<Map<String,Object>> requests=(List<Map<String,Object>>)request.getAttribute("requests"); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Blood requests · LifeLink</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><nav class="nav"><a class="brand" href="<%=request.getContextPath()%>/index.jsp">Life<span>Link</span></a><a class="secondary small" href="<%=request.getContextPath()%>/dashboard">Dashboard</a></nav><main class="auth"><section class="auth-card" style="width:min(100%,820px)"><p class="eyebrow">BLOOD BANK WORKSPACE</p><h1>Recipient requests</h1><p class="muted">Approve or reject requests. Fulfilment deducts units from inventory in one transaction.</p><c:if test="${param.updated eq '1'}"><div class="notice">Request updated successfully.</div></c:if><c:if test="${not empty param.error}"><div class="notice"><c:choose><c:when test="${param.error eq 'stock'}">Not enough recorded stock to fulfil this request.</c:when><c:otherwise>That action could not be applied. Check the request status and try again.</c:otherwise></c:choose></div></c:if><c:choose><c:when test="${empty requests}"><p class="muted">No recipient requests yet.</p></c:when><c:otherwise><div style="display:grid;gap:12px"><c:forEach items="${requests}" var="r"><article style="border:1px solid var(--line);border-radius:12px;padding:16px"><div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap"><strong><c:out value="${r.recipient}"/></strong><strong><c:out value="${r.status}"/></strong></div><p class="muted"><c:out value="${r.email}"/></p><p><strong><c:out value="${r.group}"/></strong> · <c:out value="${r.units}"/> units</p><p class="muted"><c:out value="${r.created}"/></p><c:if test="${r.status eq 'PENDING' or r.status eq 'APPROVED'}"><form method="post" action="<%=request.getContextPath()%><input type="hidden" name="csrfToken" value="<%=session.getAttribute("csrfToken")%>"/>/bank/requests" style="display:flex;gap:8px;flex-wrap:wrap"><input type="hidden" name="requestId" value="<c:out value='${r.id}'/>"/><c:if test="${r.status eq 'PENDING'}"><button class="primary" name="action" value="approve">Approve</button><button class="secondary" name="action" value="reject">Reject</button></c:if><c:if test="${r.status eq 'APPROVED'}"><button class="primary" name="action" value="fulfill">Fulfil request</button></c:if></form></c:if></article></c:forEach></div></c:otherwise></c:choose></section></main></body></html>