<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>LifeLink — Blood Donation Network</title>
<link rel="stylesheet" href="assets/css/style.css">
</head>
<body>
<nav class="nav">
  <a class="brand" href="index.jsp">Life<span>Link</span></a>
  <div class="nav-actions"><a href="login.jsp">Sign in</a><a class="primary small" href="register.jsp">Create account</a></div>
</nav>
<main>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">A better-connected blood donation network</p>
      <h1>Good people.<br><em>One vital connection.</em></h1>
      <p class="lead">LifeLink brings donors, blood banks and people in need together. Keep appointments organized, check recorded stock and coordinate requests in one place.</p>
      <div class="hero-actions"><a class="primary" href="register.jsp">Join the network</a><a class="secondary" href="login.jsp">Already registered?</a></div>
      <div class="statline"><span>8 blood groups tracked</span><span>Donor & bank workflows</span><span>Requests and transfers</span></div>
    </div>
    <div class="hero-art" aria-label="Blood donation symbol">
      <div class="blood-drop">+</div>
      <div class="art-label"><strong>Small act. Lasting impact.</strong><small>Donate · Connect · Support</small></div>
    </div>
  </section>
  <section class="feature-grid" aria-label="LifeLink features">
    <article><div class="icon">♥</div><h3>For donors</h3><p>Keep your details handy and request a donation appointment with an approved blood bank.</p></article>
    <article><div class="icon">＋</div><h3>For recipients</h3><p>Browse approved banks, view recorded stock and submit a blood request for review.</p></article>
    <article><div class="icon">▤</div><h3>For blood banks</h3><p>Maintain inventory, review appointments and manage incoming requests and transfers.</p></article>
    <article><div class="icon">↗</div><h3>For administrators</h3><p>Review new registrations and keep access to the platform organized.</p></article>
  </section>
</main>
<footer>LifeLink · Student project demonstration · Not a real medical service</footer>
</body>
</html>
