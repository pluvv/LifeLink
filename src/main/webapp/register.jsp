<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create account · LifeLink</title><link rel="stylesheet" href="assets/css/style.css"></head><body>
<nav class="nav"><a class="brand" href="index.jsp">Life<span>Link</span></a><a href="login.jsp">Log in</a></nav>
<main class="auth"><div class="auth-card"><p class="eyebrow">JOIN THE NETWORK</p><h1>Create an account</h1><p class="muted">Registrations require administrator approval before access.</p>
<% String err=request.getParameter("error"); if("exists".equals(err)){%><div class="notice">An account with this email already exists.</div><%}else if("invalid".equals(err)){%><div class="notice">Please complete all fields and use a password of at least 8 characters.</div><%}else if("failed".equals(err)){%><div class="notice">Registration failed. Please try again.</div><%}%>
<form method="post" action="register"><input type="hidden" name="csrfToken" value="<%=session.getAttribute("csrfToken")%>"/><label>Full name</label><input name="fullName" required maxlength="120"><label>Email</label><input type="email" name="email" required maxlength="190"><label>Password (min. 8 characters)</label><input type="password" name="password" required minlength="8"><label>Account type</label><select name="role" required><option value="">Choose a role</option><option value="DONOR">Donor</option><option value="RECIPIENT">Recipient</option><option value="BLOOD_BANK">Blood bank</option></select><label>Blood group (donors only)</label><select name="bloodGroup"><option value="">Select group</option><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select><label>Phone</label><input name="phone" maxlength="20"><label>City</label><input name="city" maxlength="100"><label>Blood bank name (blood bank accounts only)</label><input name="bankName" maxlength="160"><label>Bank address (blood bank accounts only)</label><input name="address" maxlength="255"><button class="primary full" type="submit">Submit registration</button></form><p class="muted center">Already registered? <a href="login.jsp">Sign in</a></p></div></main></body></html>
